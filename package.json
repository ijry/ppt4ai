{
  "name": "ppt4ai",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "test:e2e": "playwright test",
    "dev": "pnpm --filter @ppt4ai/playground dev",
    "dev:ime": "pnpm --filter @ppt4ai/ime-lab dev"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "happy-dom": "20.8.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
