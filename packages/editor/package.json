  "dependencies": {
    "@ppt4ai/engine": "workspace:*",
    "@ppt4ai/render": "workspace:*",
    "@ppt4ai/text": "workspace:*",
    "vue": "3.5.41",
    "vue-i18n": "11.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "unocss": "66.8.1",
    "vue-tsc": "3.3.11"
  }
}
